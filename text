      <div id="scan-results" style="display:none"></div>

      <div id="scan-empty" class="empty-state">
        <div style="font-size:4rem;margin-bottom:12px">🛡</div>
        <p>Enter a target URL above to begin real-time security scanning</p>
        <p style="margin-top:8px;font-size:0.75rem;color:var(--muted2)">Supports any public domain or URL • 10 security modules • PDF report generation</p>
      </div>
    </div>

    <!-- ── HISTORY PAGE ── -->
    <div id="page-history" class="page">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <div>
          <h1 style="font-family:var(--orb);font-size:1.35rem;color:var(--cyan);text-shadow:0 0 15px rgba(0,180,255,0.5);letter-spacing:3px;margin-bottom:6px">SCAN HISTORY</h1>
          <p id="history-sub" style="color:var(--muted2);font-family:var(--mono);font-size:0.72rem;letter-spacing:1px"></p>
        </div>
        <div id="history-count" style="background:rgba(0,180,255,0.1);border:1px solid rgba(0,180,255,0.3);border-radius:8px;padding:8px 18px;color:var(--cyan);font-family:var(--orb);font-size:0.72rem;letter-spacing:2px"></div>
