      <div class="panel">
        <div class="scan-form">
          <div class="scan-input-wrap">
            <span class="scan-input-icon">🔍</span>
            <input id="scan-url" class="scan-input" type="text" placeholder="Enter target URL or domain (e.g. https://example.com)" />
          </div>
          <button id="scan-btn" class="scan-btn" onclick="startScan()">▶ SCAN</button>
        </div>
        <div class="api-tags">
          <span class="api-tag">Google DNS API</span>
          <span class="api-tag">SSL Labs API</span>
          <span class="api-tag">URLScan.io API</span>
