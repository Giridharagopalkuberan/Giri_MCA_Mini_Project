  { title:'Critical Zero-Day in Popular VPN Software Actively Exploited', source:'The Hacker News', publishedAt:new Date().toISOString(), summary:'Security researchers discovered a critical zero-day in a widely-deployed VPN solution affecting millions. Emergency patches released. Immediate update required.', url:'https://thehackernews.com', imageUrl:'https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=400&h=200&fit=crop', category:'Vulnerability'},
  { title:'State-Sponsored Hackers Breach Government Networks in Multi-Country Campaign', source:'Security Affairs', publishedAt:new Date().toISOString(), summary:'A sophisticated APT group linked to a nation-state actor compromised government ministries and defense contractors across multiple countries in a coordinated espionage campaign.', url:'https://securityaffairs.com', imageUrl:'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=400&h=200&fit=crop', category:'Breach'},
  { title:'Malware Campaign Spreads via Fake Software Updates Targeting Enterprises', source:'Krebs on Security', publishedAt:new Date().toISOString(), summary:'Threat actors distributing infostealer malware disguised as legitimate software updates for productivity tools, targeting thousands of corporate employees worldwide.', url:'https://krebsonsecurity.com', imageUrl:'https://images.unsplash.com/photo-1510511459019-5dda7724fd87?w=400&h=200&fit=crop', category:'Malware'},
  { title:'50 Million User Records Exposed in Social Platform Data Breach', source:'Threatpost', publishedAt:new Date().toISOString(), summary:'A major platform disclosed a breach exposing emails, phone numbers and hashed passwords of 50 million users. Credential stuffing attacks expected to follow.', url:'https://threatpost.com', imageUrl:'https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=400&h=200&fit=crop', category:'Breach'},
  { title:'Critical Auth Bypass in Enterprise Firewalls: Patch Immediately', source:'Dark Reading', publishedAt:new Date().toISOString(), summary:'Multiple enterprise firewall vendors issued emergency patches after disclosure of a critical authentication bypass allowing unauthenticated remote code execution.', url:'https://www.darkreading.com', imageUrl:'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=400&h=200&fit=crop', category:'Vulnerability'},
  { title:'FBI Alert: Business Email Compromise Attacks Surge 45% in 2025', source:'CISA', publishedAt:new Date().toISOString(), summary:'FBI and CISA issued a joint advisory warning of a significant surge in BEC attacks targeting financial departments at mid-sized companies, causing billions in losses.', url:'https://www.cisa.gov/news-events/cybersecurity-advisories', imageUrl:'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=400&h=200&fit=crop', category:'Advisory'},
];

const CAT_COLORS = { Breach:'#FF003C', Ransomware:'#FF6030', Vulnerability:'#FFD700', Advisory:'#00B4FF', Malware:'#FF4080' };

async function loadBlogs() {
  // Check 24h cache
  try {
    const raw = localStorage.getItem(NEWS_KEY);
    if (raw) {
      const { articles, ts } = JSON.parse(raw);
      if (Date.now() - ts < NEWS_TTL && articles?.length) {
        renderBlogs(articles);
        document.getElementById('blogs-cache-note').textContent = `⚡ Cached · last updated ${new Date(ts).toLocaleString()} · auto-refreshes every 24h`;
        return;
      }
    }
  } catch {}

  await fetchAndRenderBlogs();
}

async function forceRefreshBlogs() {
  localStorage.removeItem(NEWS_KEY);
  await fetchAndRenderBlogs();
}

async function fetchAndRenderBlogs() {
  document.getElementById('blogs-loading').style.display = '';
  document.getElementById('blogs-grid').innerHTML = '';
  const FEEDS = [
    { url:'https://krebsonsecurity.com/feed/', source:'Krebs on Security' },
    { url:'https://www.schneier.com/blog/atom.xml', source:'Schneier on Security' },
    { url:'https://securityaffairs.com/feed', source:'Security Affairs' },
    { url:'https://threatpost.com/feed/', source:'Threatpost' },
    { url:'https://feeds.feedburner.com/TheHackersNews', source:'The Hacker News' },
    { url:'https://www.darkreading.com/rss.xml', source:'Dark Reading' },
  ];
  const proxy = 'https://api.rss2json.com/v1/api.json';
  const results = await Promise.allSettled(FEEDS.map(f =>
    fetch(`${proxy}?rss_url=${encodeURIComponent(f.url)}&count=3`).then(r=>r.json()).then(d => {
      if (d.status !== 'ok') return [];
      return (d.items||[]).map(item => ({
        title: item.title, source: f.source, publishedAt: item.pubDate,
        summary: (item.description||item.content||'').replace(/<[^>]*>/g,'').trim().slice(0,200)+'...',
        url: item.link, imageUrl: item.thumbnail || item.enclosure?.link || 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=400&h=200&fit=crop',
        category: detectCat(item.title||''),
      }));
    })
  ));
  const live = results.filter(r=>r.status==='fulfilled'&&r.value.length).flatMap(r=>r.value).sort((a,b)=>new Date(b.publishedAt)-new Date(a.publishedAt));
  const articles = live.length >= 4 ? live : [...live, ...NEWS_FALLBACK].slice(0,12);
  try { localStorage.setItem(NEWS_KEY, JSON.stringify({ articles, ts: Date.now() })); } catch {}
  const note = `🔄 Fetched live · ${new Date().toLocaleString()} · auto-refreshes every 24h`;
  document.getElementById('blogs-cache-note').textContent = note;
  document.getElementById('blogs-loading').style.display = 'none';
  renderBlogs(articles);
}

function detectCat(title) {
  const t = title.toLowerCase();
  if (t.includes('ransomware')) return 'Ransomware';
  if (t.includes('breach')||t.includes('leak')||t.includes('stolen')) return 'Breach';
  if (t.includes('cve')||t.includes('vulnerabilit')||t.includes('zero-day')) return 'Vulnerability';
  if (t.includes('malware')||t.includes('phishing')||t.includes('trojan')) return 'Malware';
  return 'Advisory';
}

function renderBlogs(articles) {
  document.getElementById('blogs-loading').style.display = 'none';
  const fallback = 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=400&h=200&fit=crop';
  document.getElementById('blogs-grid').innerHTML = articles.map(a => {
    const cc = CAT_COLORS[a.category] || '#00B4FF';
    return `
      <a class="news-card" href="${a.url}" target="_blank" rel="noopener">
        <div class="news-thumb">
          <img src="${a.imageUrl||fallback}" alt="" onerror="this.src='${fallback}'" />
          <div class="news-thumb-overlay"></div>
          ${a.category ? `<span class="news-cat" style="color:${cc};border-color:${cc}60;background:${cc}20">${a.category}</span>` : ''}
        </div>
        <div class="news-body">
          <div class="news-title">${escHtml(a.title)}</div>
          <div class="news-summary">${escHtml(a.summary)}</div>
          <div class="news-footer">
            <span class="news-date">📅 ${a.publishedAt ? new Date(a.publishedAt).toLocaleDateString() : 'Recent'}</span>
            <span class="news-source">${escHtml(a.source)} ↗</span>
          </div>
        </div>
      </a>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════
//  PDF REPORT  (uses jsPDF from CDN, loaded lazily)
// ═══════════════════════════════════════════════════════════════
function generatePDF(results) {
  if (typeof window.jspdf === 'undefined') {
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    s.onload = () => _buildPDF(results);
    document.head.appendChild(s);
  } else { _buildPDF(results); }
}

function _buildPDF(results) {
  const { jsPDF } = window.jspdf;
  const doc  = new jsPDF();
  const W    = 210, M = 15, CW = W - M*2;
  const SEV_C = { Critical:[255,0,60], High:[255,96,48], Medium:[255,215,0], Low:[0,230,118], Safe:[0,255,136] };
  const wrap  = (text, x, y, maxW, lh=5.5) => { const ls=doc.splitTextToSize(String(text||''),maxW); ls.forEach((l,i)=>doc.text(l,x,y+i*lh)); return y+ls.length*lh; };

  // Cover
  doc.setFillColor(5,10,15); doc.rect(0,0,210,297,'F');
  doc.setFillColor(0,100,180); doc.rect(0,0,210,4,'F');
  doc.setTextColor(0,180,255); doc.setFontSize(28); doc.setFont('helvetica','bold');
  doc.text('SECLITE', 105, 55, {align:'center'});
  doc.setFontSize(11); doc.setTextColor(150,200,255);
  doc.text('UNIFIED SECURITY SCANNER — CONFIDENTIAL REPORT', 105, 66, {align:'center'});
  doc.setDrawColor(0,100,180); doc.line(M,74,W-M,74);
  doc.setTextColor(200,230,255); doc.setFontSize(10); doc.setFont('helvetica','normal');
  doc.text(`Target: ${results.targetUrl||results.hostname}`, M, 86);
  doc.text(`Scanned: ${new Date(results.scannedAt||Date.now()).toLocaleString()}`, M, 94);

  const oc = SEV_C[results.overallSeverity]||[0,180,255];
  doc.setFillColor(...oc); doc.roundedRect(M,108,CW,35,3,3,'F');
  doc.setTextColor(5,10,15); doc.setFontSize(36); doc.setFont('helvetica','bold');
  doc.text(`${Math.round(results.overallScore||0)}`, 60, 131, {align:'center'});
  doc.setFontSize(11); doc.text('OVERALL SCORE', 60, 140, {align:'center'});
  doc.setFontSize(24); doc.text(results.overallSeverity||'N/A', 155, 128, {align:'center'});
  doc.setFontSize(10); doc.text('SEVERITY', 155, 138, {align:'center'});

  doc.setTextColor(80,130,160); doc.setFontSize(8);
  doc.text('CONFIDENTIAL — Generated by SecLite Security Platform — For Authorized Use Only', 105, 288, {align:'center'});

  // Module pages
  (results.modules||[]).forEach(mod => {
    doc.addPage();
    doc.setFillColor(5,10,15); doc.rect(0,0,210,297,'F');
    const mc = SEV_C[mod.severity]||[0,180,255];
    doc.setFillColor(...mc); doc.rect(0,0,4,297,'F');
    let y = 18;
    doc.setTextColor(...mc); doc.setFontSize(15); doc.setFont('helvetica','bold');
    doc.text((mod.name||'').toUpperCase(), M+4, y); y+=8;
    doc.setTextColor(180,220,255); doc.setFontSize(9); doc.setFont('helvetica','normal');
    y = wrap(mod.summary||'', M+4, y, CW-4); y+=3;

    // Score badge
    doc.setFillColor(15,28,40); doc.roundedRect(M+4,y,55,18,2,2,'F');
    doc.setTextColor(...mc); doc.setFontSize(22); doc.setFont('helvetica','bold');
    doc.text(`${mod.score}`, M+22, y+13, {align:'center'});
    doc.setFontSize(8); doc.setTextColor(130,190,220);
    doc.text('SCORE', M+38, y+8); doc.setFontSize(10); doc.text(mod.severity||'', M+38, y+15);
    y+=24;

    const sec = (title, items) => {
      if (!items?.length) return;
      doc.setFillColor(18,32,46); doc.rect(M+4,y,CW-4,7,'F');
      doc.setTextColor(0,180,255); doc.setFontSize(8); doc.setFont('helvetica','bold');
      doc.text(title, M+7, y+5); y+=9;
      doc.setFont('helvetica','normal'); doc.setTextColor(180,220,255); doc.setFontSize(7.5);
      items.forEach((item,i) => {
        const t = `${i+1}. ${item}`;
        y = wrap(t, M+8, y, CW-12, 4.8); y+=2;
        if (y>272) { doc.addPage(); doc.setFillColor(5,10,15); doc.rect(0,0,210,297,'F'); y=16; }
      });
      y+=3;
    };

    sec('FINDINGS', mod.findings);
    sec('RECOMMENDATIONS', mod.recommendations);
    sec('HOW TO FIX', mod.howToFix);
    if (mod.threatImpact) {
      doc.setFillColor(18,32,46); doc.rect(M+4,y,CW-4,7,'F');
      doc.setTextColor(0,180,255); doc.setFontSize(8); doc.setFont('helvetica','bold');
      doc.text('THREAT IMPACT', M+7, y+5); y+=9;
      doc.setFont('helvetica','normal'); doc.setTextColor(180,220,255); doc.setFontSize(7.5);
      y = wrap(mod.threatImpact, M+8, y, CW-12, 4.8); y+=4;
    }
    if (mod.references?.length) {
      doc.setTextColor(80,120,200); doc.setFontSize(7.5);
      mod.references.forEach(r => { doc.text(`• ${r.title}: ${r.url}`, M+6, y, {maxWidth:CW-8}); y+=5; });
    }
  });

  const fname = `SecLite_${(results.hostname||'scan').replace(/[^a-z0-9]/gi,'_')}_${new Date().toISOString().split('T')[0]}.pdf`;
  doc.save(fname);
}
</script>
