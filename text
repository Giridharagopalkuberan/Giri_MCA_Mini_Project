    </div>

    <!-- ── BLOGS PAGE ── -->
    <div id="page-blogs" class="page">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:14px">
        <div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
            <span style="font-size:1.2rem">📡</span>
            <h1 style="font-family:var(--orb);font-size:1.35rem;color:var(--cyan);text-shadow:0 0 15px rgba(0,180,255,0.5);letter-spacing:3px;margin:0">CYBER THREAT INTEL</h1>
          </div>
          <p style="color:var(--muted2);font-family:var(--mono);font-size:0.7rem;letter-spacing:1px;margin-bottom:4px">Krebs · Schneier · Security Affairs · Threatpost · The Hacker News · Dark Reading</p>
          <p id="blogs-cache-note" style="color:#1A3040;font-family:var(--mono);font-size:0.67rem"></p>
        </div>
        <button onclick="forceRefreshBlogs()" id="blogs-refresh-btn" style="display:flex;align-items:center;gap:8px;padding:9px 18px;background:rgba(0,180,255,0.08);border:1px solid rgba(0,180,255,0.3);border-radius:6px;color:var(--cyan);cursor:pointer;font-family:var(--orb);font-size:0.67rem;letter-spacing:2px">
          🔄 FORCE REFRESH
        </button>
      </div>
      <div class="ticker"><span>⚠</span><span>LIVE THREAT FEED — Latest cybersecurity incidents, vulnerabilities &amp; advisories</span></div>
      <div id="blogs-loading" style="text-align:center;padding:80px 0;display:none">
        <div class="spinner"></div>
        <p style="margin-top:14px;color:var(--muted);font-family:var(--mono);font-size:0.8rem">FETCHING THREAT INTELLIGENCE...</p>
      </div>
      <div id="blogs-grid" class="blogs-grid"></div>
    </div>
  </main>
</div>

<script>
// ═══════════════════════════════════════════════════════════════
//  UI STATE & AUTH
// ═══════════════════════════════════════════════════════════════
const AUTH_KEY    = 'seclite_user';
const HISTORY_KEY = 'seclite_history';
const NEWS_KEY    = 'seclite_news';
const NEWS_TTL    = 24 * 60 * 60 * 1000;

let currentUser = null;

function getLocalUser()      { try { return JSON.parse(localStorage.getItem(AUTH_KEY) || 'null'); } catch { return null; } }
function saveLocalUser(u)    { localStorage.setItem(AUTH_KEY, JSON.stringify(u)); }
function clearLocalUser()    { localStorage.removeItem(AUTH_KEY); }

function showAuthSelector()  { document.getElementById('auth-selector').style.display=''; document.getElementById('auth-user-form').style.display='none'; document.getElementById('auth-admin-form').style.display='none'; }
function showAuthForm(type)  { showAuthSelector(); document.getElementById('auth-selector').style.display='none'; document.getElementById(type==='user'?'auth-user-form':'auth-admin-form').style.display=''; }

function doUserLogin() {
  const email = document.getElementById('login-email').value.trim();
  const err   = document.getElementById('login-error');
  if (!email || !email.includes('@')) { err.style.display=''; err.textContent='Enter a valid email address'; return; }
  const u = { email, full_name: email.split('@')[0], isAdmin: false };
  saveLocalUser(u);
  bootApp(u);
}

function doAdminLogin() {
  const u = document.getElementById('admin-user').value.trim();
  const p = document.getElementById('admin-pass').value;
  const err = document.getElementById('admin-error');
  if (u === 'admin' && p === 'admin@123') {
    const usr = { email: 'admin@seclite.local', full_name: 'Administrator', isAdmin: true };
    saveLocalUser(usr);
    bootApp(usr);
  } else {
    err.style.display=''; err.textContent='ACCESS DENIED: Invalid credentials';
    setTimeout(() => { err.style.display='none'; }, 3000);
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    if (document.getElementById('auth-user-form').style.display !== 'none') doUserLogin();
    else if (document.getElementById('auth-admin-form').style.display !== 'none') doAdminLogin();
    else if (document.getElementById('scan-url') === document.activeElement) startScan();
  }
});

function doLogout() { clearLocalUser(); location.reload(); }

function bootApp(user) {
  currentUser = user;
  document.getElementById('auth-gate').style.display = 'none';
  document.getElementById('app').style.display = '';
  document.getElementById('nav-username').textContent = user.full_name || user.email;
  if (user.isAdmin) document.getElementById('admin-badge').style.display = '';
  showPage('scan');
  loadBlogs();
}

window.addEventListener('DOMContentLoaded', () => {
  const u = getLocalUser();
  if (u) bootApp(u);
});

// ═══════════════════════════════════════════════════════════════
//  PAGE ROUTING
// ═══════════════════════════════════════════════════════════════
function showPage(name) {
  ['scan','history','blogs'].forEach(p => {
    document.getElementById('page-'+p).classList.toggle('active', p===name);
    document.getElementById('nav-'+p).classList.toggle('active', p===name);
  });
  if (name === 'history') renderHistory();
}

// ═══════════════════════════════════════════════════════════════
//  SEVERITY HELPERS
// ═══════════════════════════════════════════════════════════════
const SEV_COLOR = { Critical:'#FF003C', High:'#FF6030', Medium:'#FFD700', Low:'#00E676', Safe:'#00FF88' };
const SEV_RANK  = { Critical:0, High:1, Medium:2, Low:3, Safe:4 };
function sevColor(s) { return SEV_COLOR[s] || '#00B4FF'; }
function sevBg(s)    { const c=sevColor(s); return c+'14'; }
function sevBorder(s){ const c=sevColor(s); return c+'40'; }

// ═══════════════════════════════════════════════════════════════
//  SCAN
// ═══════════════════════════════════════════════════════════════
let lastResults = null;

async function startScan() {
  const target = document.getElementById('scan-url').value.trim();
  if (!target) return;

  document.getElementById('scan-btn').disabled = true;
  document.getElementById('scan-btn').textContent = 'SCANNING...';
  document.getElementById('progress-panel').style.display = '';
  document.getElementById('scan-results').style.display = 'none';
  document.getElementById('scan-empty').style.display = 'none';
  document.getElementById('progress-fill').style.width = '2%';

  try {
    const results = await SCANNER.runScan(target, ({ pct, step }) => {
      document.getElementById('progress-step').textContent = step;
      document.getElementById('progress-pct').textContent  = pct + '%';
      document.getElementById('progress-fill').style.width = pct + '%';
    });

    lastResults = results;
    saveScanToHistory(results);
    renderScanResults(results, 'scan-results');
    document.getElementById('scan-results').style.display = '';
    document.getElementById('progress-panel').style.display = 'none';
  } catch (e) {
    console.error(e);
    alert('Scan failed: ' + e.message);
    document.getElementById('progress-panel').style.display = 'none';
    document.getElementById('scan-empty').style.display = '';
  }

  document.getElementById('scan-btn').disabled = false;
  document.getElementById('scan-btn').textContent = '▶ SCAN';
}

// ═══════════════════════════════════════════════════════════════
//  RENDER SCAN RESULTS (reused by scan page & history expand)
// ═══════════════════════════════════════════════════════════════
function renderScanResults(results, containerId, compact = false) {
  const el = document.getElementById(containerId);
  const oc = sevColor(results.overallSeverity);
  const sorted = [...(results.modules||[])].sort((a,b)=>(SEV_RANK[a.severity]??5)-(SEV_RANK[b.severity]??5));

  const criticals = sorted.filter(m=>m.severity==='Critical'||m.severity==='High').length;
  const mediums   = sorted.filter(m=>m.severity==='Medium').length;
  const safes     = sorted.filter(m=>m.severity==='Low'||m.severity==='Safe').length;

  const scoreCircle = `
    <svg width="100" height="100" style="transform:rotate(-90deg)">
      <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="8"/>
      <circle cx="50" cy="50" r="40" fill="none" stroke="${oc}" stroke-width="8"
        stroke-dasharray="${(results.overallScore/100)*(2*Math.PI*40)} ${2*Math.PI*40}"
        stroke-linecap="round" style="filter:drop-shadow(0 0 6px ${oc})"/>
    </svg>
    <div style="margin-top:-62px;text-align:center">
      <div style="font-family:var(--orb);font-size:1.5rem;font-weight:900;color:${oc};text-shadow:0 0 16px ${oc};line-height:1">${results.overallScore}</div>
      <div style="font-family:var(--mono);font-size:0.5rem;letter-spacing:2px;color:var(--muted2);margin-top:2px">SCORE</div>
    </div>
  `;

  const modulesHtml = sorted.map((m, idx) => buildModuleHtml(m, idx, containerId)).join('');

  el.innerHTML = `
    <div class="results-summary" style="background:${oc}0d;border:1px solid ${oc}35;box-shadow:0 0 20px ${oc}12">
      <div class="gauge-wrap">
        ${scoreCircle}
        <div class="gauge-sev" style="color:${oc}">${results.overallSeverity?.toUpperCase()}</div>
      </div>
      <div class="summary-right">
        <div class="summary-title" style="color:${oc}">${results.overallSeverity?.toUpperCase()} RISK</div>
        <div class="summary-sub">Assessment complete for <span style="color:var(--cyan);font-family:var(--mono)">${results.hostname||results.targetUrl}</span></div>
        <div class="stat-badges">
          <div class="stat-badge" style="border:1px solid #FF003C30"><div class="val" style="color:#FF003C">${criticals}</div><div class="lbl">CRITICAL/HIGH</div></div>
          <div class="stat-badge" style="border:1px solid #FFD70030"><div class="val" style="color:#FFD700">${mediums}</div><div class="lbl">MEDIUM</div></div>
          <div class="stat-badge" style="border:1px solid #00E67630"><div class="val" style="color:#00E676">${safes}</div><div class="lbl">LOW/SAFE</div></div>
          <div class="stat-badge" style="border:1px solid rgba(0,180,255,0.2)"><div class="val" style="color:var(--cyan)">${sorted.length}</div><div class="lbl">MODULES</div></div>
        </div>
      </div>
      <button class="pdf-btn" onclick='generatePDF(${JSON.stringify(results).replace(/'/g,"\\'")})'  style="align-self:center">📄 PDF REPORT</button>
    </div>

    <div class="info-banner">
      ℹ️ DNS + Email + WHOIS + Reputation: Live API data &nbsp;|&nbsp; SSL: SSL Labs A/B/F grade &nbsp;|&nbsp; Headers/CSP/Ports/Malware/Vuln: Heuristic analysis &nbsp;|&nbsp; Click any row to expand
    </div>

    <div class="modules-list">${modulesHtml}</div>

    <div style="text-align:center;margin-top:20px">
      <button class="pdf-btn" onclick='generatePDF(${JSON.stringify(results).replace(/'/g,"\\'")})'  style="padding:12px 28px;font-size:0.82rem">📄 DOWNLOAD FULL PDF REPORT</button>
    </div>
  `;
}

const _expandState = {};

function buildModuleHtml(m, idx, prefix) {
  const c       = sevColor(m.severity);
  const bodyId  = `mod-body-${prefix}-${idx}`;
  const isOpen  = m.severity === 'Critical';

  const findingsHtml = (m.findings||[]).map((f,i) => `
    <div class="module-section-item">
      <span class="module-section-num" style="color:${c}">${String(i+1).padStart(2,'0')}.</span>
      <span>${escHtml(f)}</span>
    </div>`).join('');

  const recsHtml = (m.recommendations||[]).map(r => `
    <div class="module-section-item">
      <span style="color:#00FF88;flex-shrink:0;margin-top:2px">✓</span>
      <span>${escHtml(r)}</span>
    </div>`).join('');

  const stepsHtml = (m.howToFix||[]).map((s,i) => `
    <div class="module-section-item" style="align-items:flex-start">
      <div style="background:rgba(0,180,255,0.2);border:1px solid rgba(0,180,255,0.4);border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-family:var(--orb);font-size:0.55rem;color:var(--cyan);flex-shrink:0">${i+1}</div>
      <span style="padding-top:1px">${escHtml(s)}</span>
    </div>`).join('');

  const refsHtml = (m.references||[]).map(r => `<a href="${r.url}" target="_blank" rel="noopener">↗ ${escHtml(r.title)}</a>`).join('');

  const summaryHtml = m.summary ? `<p class="module-summary" style="border-color:${c}60">${escHtml(m.summary)}</p>` : '';

  const threatHtml = m.threatImpact ? `
    <div class="module-threat">
      <div class="module-threat-title">⚡ THREAT IMPACT</div>
      <p>${escHtml(m.threatImpact)}</p>
    </div>` : '';

  return `
    <div class="module-row">
      <button class="module-header" style="border-color:${c}35;background:${sevBg(m.severity)}" onclick="toggleModule('${bodyId}', this)">
        <span class="module-chevron" style="color:${isOpen?c:'var(--muted)'}">${isOpen?'▼':'▶'}</span>
        <span class="module-name">${escHtml(m.name)}</span>
        <div class="module-bar-wrap">
          <div class="module-bar"><div class="module-bar-fill" style="width:${m.score}%;background:${c}"></div></div>
          <span class="module-score" style="color:${c};text-shadow:0 0 8px ${c}">${m.score}</span>
          <span class="module-sev" style="color:${c};background:${c}1a;border-color:${c}50">${m.severity?.toUpperCase()}</span>
        </div>
      </button>
      <div id="${bodyId}" class="module-body ${isOpen?'open':''}" style="border-color:${c}25;background:${sevBg(m.severity)}">
        ${summaryHtml}
        <div class="module-grid">
          ${findingsHtml ? `<div class="module-section"><div class="module-section-title" style="color:${c}">⚠ FINDINGS</div>${findingsHtml}</div>` : ''}
          ${recsHtml    ? `<div class="module-section"><div class="module-section-title" style="color:#00FF88">✓ RECOMMENDATIONS</div>${recsHtml}</div>` : ''}
          ${stepsHtml   ? `<div class="module-section"><div class="module-section-title" style="color:var(--cyan)">🔧 HOW TO FIX</div>${stepsHtml}</div>` : ''}
          ${threatHtml}
        </div>
        ${refsHtml ? `<div class="module-refs"><span>📚 REFS:</span>${refsHtml}</div>` : ''}
      </div>
    </div>`;
}

function toggleModule(id, btn) {
  const body = document.getElementById(id);
  const open = body.classList.toggle('open');
  btn.querySelector('.module-chevron').textContent = open ? '▼' : '▶';
}

function escHtml(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ═══════════════════════════════════════════════════════════════
//  HISTORY
// ═══════════════════════════════════════════════════════════════
function getHistory() { try { return JSON.parse(localStorage.getItem(HISTORY_KEY)||'[]'); } catch { return []; } }

function saveScanToHistory(results) {
  const all = getHistory();
  const entry = {
    id: Date.now().toString(),
    user_email: currentUser?.email || 'anonymous',
    target_url: results.targetUrl,
    hostname: results.hostname,
    overall_score: results.overallScore,
    overall_severity: results.overallSeverity,
    scan_data: JSON.stringify(results),
    created_date: new Date().toISOString(),
  };
  all.unshift(entry);
  localStorage.setItem(HISTORY_KEY, JSON.stringify(all.slice(0,200)));
}

function deleteHistoryItem(id) {
  const all = getHistory().filter(s => s.id !== id);
  localStorage.setItem(HISTORY_KEY, JSON.stringify(all));
  renderHistory();
}

function renderHistory() {
  const all   = getHistory();
  const items = currentUser?.isAdmin ? all : all.filter(s => s.user_email === currentUser?.email);
  document.getElementById('history-sub').textContent   = currentUser?.isAdmin ? 'All users — admin view' : `Showing history for ${currentUser?.email}`;
  document.getElementById('history-count').textContent = items.length + ' SCANS';

  const list = document.getElementById('history-list');
  if (!items.length) {
    list.innerHTML = '<div class="empty-state"><div style="font-size:3.5rem">🕐</div><p>No scan history yet. Run your first scan!</p></div>';
    return;
  }

  list.innerHTML = items.map(scan => {
    const c = sevColor(scan.overall_severity);
    return `
      <div class="history-row" style="border:1px solid ${c}25;box-shadow:0 0 10px ${c}12">
        <div class="history-row-header" onclick="toggleHistoryRow('hist-body-${scan.id}')">
          <div class="history-icon" style="background:${c}20"><span style="color:${c}">🌐</span></div>
          <div style="flex:1;min-width:0">
            <div class="history-url">${escHtml(scan.target_url)}</div>
            <div class="history-meta">${new Date(scan.created_date).toLocaleString()}${currentUser?.isAdmin?' · '+scan.user_email:''}</div>
          </div>
          <div style="text-align:center;min-width:50px">
            <div class="history-score" style="color:${c};text-shadow:0 0 8px ${c}">${Math.round(scan.overall_score||0)}</div>
            <div class="history-sev" style="color:${c}">${scan.overall_severity}</div>
          </div>
          <div class="history-actions" onclick="event.stopPropagation()">
            <button class="history-pdf-btn" onclick="generatePDFFromScan('${scan.id}')">📄 PDF</button>
            <button class="history-del-btn" onclick="deleteHistoryItem('${scan.id}')">🗑</button>
            <span style="color:var(--muted2);font-size:14px">▶</span>
          </div>
        </div>
        <div id="hist-body-${scan.id}" style="display:none">
          <div class="history-modules">
            <div id="hist-results-${scan.id}"></div>
          </div>
        </div>
      </div>`;
  }).join('');
}

const _historyLoaded = {};
function toggleHistoryRow(bodyId) {
  const el = document.getElementById(bodyId);
  const open = el.style.display === 'none' || !el.style.display;
  el.style.display = open ? '' : 'none';
  // Render modules inline on first open
  const id = bodyId.replace('hist-body-','');
  if (open && !_historyLoaded[id]) {
    _historyLoaded[id] = true;
    const scan = getHistory().find(s => s.id === id);
    if (scan?.scan_data) {
      const results = JSON.parse(scan.scan_data);
      const containerId = 'hist-results-' + id;
      renderScanResults(results, containerId, true);
    }
  }
}

function generatePDFFromScan(id) {
  const scan = getHistory().find(s => s.id === id);
  if (scan?.scan_data) generatePDF(JSON.parse(scan.scan_data));
}

// ═══════════════════════════════════════════════════════════════
