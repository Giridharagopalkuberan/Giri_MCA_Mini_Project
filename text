<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SecLite — Unified Security Scanner</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
<script src="scanner.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg:       #050A0F;
    --bg2:      #080F18;
    --card:     rgba(8,16,28,0.85);
    --border:   rgba(0,180,255,0.15);
    --cyan:     #00B4FF;
    --cyan2:    rgba(0,180,255,0.08);
    --text:     #C8E6FF;
    --muted:    #5A8FA8;
    --muted2:   #3A5A6A;
    --mono:     'Share Tech Mono', monospace;
    --orb:      'Orbitron', sans-serif;
    --raj:      'Rajdhani', sans-serif;
  }
  body { background: var(--bg); color: var(--text); font-family: var(--raj); min-height: 100vh; }
  body::before { content:''; position:fixed; inset:0; background-image: linear-gradient(rgba(0,180,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(0,180,255,0.02) 1px,transparent 1px); background-size:60px 60px; pointer-events:none; z-index:0; }

  /* ── Layout ── */
  #app { position:relative; z-index:1; }
  nav  { position:sticky; top:0; z-index:100; background:rgba(5,10,15,0.96); border-bottom:1px solid var(--border); backdrop-filter:blur(20px); padding:0 28px; display:flex; align-items:center; justify-content:space-between; height:64px; }
  nav .logo { display:flex; align-items:center; gap:10px; cursor:pointer; }
  nav .logo span { font-family:var(--orb); font-size:1.2rem; font-weight:900; color:var(--cyan); text-shadow:0 0 15px rgba(0,180,255,0.6); letter-spacing:3px; }
  nav .navlinks { display:flex; gap:4px; }
  nav .navlinks button { padding:8px 18px; border-radius:6px; border:1px solid transparent; background:transparent; cursor:pointer; font-family:var(--orb); font-size:0.68rem; letter-spacing:2px; color:var(--muted); transition:all 0.2s; }
  nav .navlinks button.active { color:var(--cyan); background:rgba(0,180,255,0.1); border-color:rgba(0,180,255,0.3); }
  nav .user-zone { display:flex; align-items:center; gap:10px; }
  nav .user-zone .username { color:var(--muted); font-family:var(--mono); font-size:0.8rem; }
  nav .user-zone .logout-btn { background:rgba(255,0,60,0.1); border:1px solid rgba(255,0,60,0.3); border-radius:6px; color:#FF6080; cursor:pointer; padding:6px 14px; font-family:var(--raj); font-size:0.85rem; }
  nav .admin-badge { background:rgba(255,0,60,0.15); border:1px solid rgba(255,0,60,0.4); color:#FF6080; padding:3px 10px; border-radius:4px; font-family:var(--mono); font-size:0.68rem; letter-spacing:1px; }

  main { max-width:980px; margin:0 auto; padding:28px; }

  /* ── Auth Gate ── */
  #auth-gate { position:fixed; inset:0; background:#050A0F; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:999; }
  #auth-gate::before { content:''; position:fixed; inset:0; background-image:linear-gradient(rgba(0,180,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,180,255,0.03) 1px,transparent 1px); background-size:50px 50px; pointer-events:none; }
  .auth-box { background:rgba(10,20,35,0.9); border:1px solid rgba(0,180,255,0.2); border-radius:12px; padding:40px; width:100%; max-width:420px; position:relative; z-index:1; box-shadow:0 0 60px rgba(0,180,255,0.1); }
  .auth-box h2 { font-family:var(--orb); font-size:0.9rem; letter-spacing:2px; color:var(--cyan); text-align:center; margin-bottom:28px; }
  .auth-btn-group button { width:100%; padding:14px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px; font-family:var(--raj); font-size:1rem; font-weight:600; letter-spacing:1px; transition:all 0.2s; margin-bottom:12px; }
  .auth-btn-user { background:transparent; border:1px solid rgba(0,180,255,0.4); color:var(--text); }
  .auth-btn-user:hover { border-color:var(--cyan); box-shadow:0 0 20px rgba(0,180,255,0.3); background:rgba(0,180,255,0.05); }
  .auth-btn-admin { background:rgba(255,0,60,0.05); border:1px solid rgba(255,0,60,0.3); color:#FF6080; margin-top:4px; }
  .auth-btn-admin:hover { border-color:#FF003C; box-shadow:0 0 15px rgba(255,0,60,0.3); }
  .auth-divider { text-align:center; color:var(--muted2); font-family:var(--mono); font-size:0.75rem; margin:8px 0; }
  .auth-back { background:none; border:none; color:var(--muted); cursor:pointer; font-size:1.1rem; margin-right:10px; }
  .auth-form-title { font-family:var(--orb); font-size:0.85rem; letter-spacing:2px; margin-bottom:24px; display:flex; align-items:center; }
  .auth-label { color:var(--muted); font-family:var(--mono); font-size:0.72rem; letter-spacing:1px; display:block; margin-bottom:6px; }
  .auth-input { width:100%; padding:12px; background:rgba(0,180,255,0.04); border:1px solid rgba(0,180,255,0.2); border-radius:6px; color:var(--text); font-family:var(--mono); font-size:0.9rem; outline:none; margin-bottom:14px; }
  .auth-input:focus { border-color:var(--cyan); }
  .auth-input-red { background:rgba(255,0,60,0.04); border-color:rgba(255,0,60,0.2); }
  .auth-submit { width:100%; padding:13px; border-radius:8px; cursor:pointer; font-family:var(--orb); font-size:0.82rem; letter-spacing:2px; }
  .auth-submit-user  { background:linear-gradient(135deg,rgba(0,180,255,0.2),rgba(0,100,200,0.3)); border:1px solid rgba(0,180,255,0.5); color:var(--cyan); }
  .auth-submit-admin { background:linear-gradient(135deg,rgba(255,0,60,0.2),rgba(200,0,40,0.3)); border:1px solid rgba(255,0,60,0.5); color:#FF6080; }
  .auth-error { color:#FF003C; font-family:var(--mono); font-size:0.78rem; text-align:center; margin-bottom:12px; padding:8px; background:rgba(255,0,60,0.1); border-radius:4px; }

  /* ── Cards / Panels ── */
  .panel { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:20px; margin-bottom:16px; }
  .panel-title { font-family:var(--orb); font-size:0.85rem; color:var(--cyan); letter-spacing:2px; margin-bottom:16px; display:flex; align-items:center; gap:8px; }

  /* ── Scan Input ── */
  .scan-form { display:flex; gap:10px; }
  .scan-input-wrap { flex:1; position:relative; }
  .scan-input { width:100%; padding:13px 16px 13px 44px; background:rgba(0,180,255,0.04); border:1px solid rgba(0,180,255,0.25); border-radius:6px; color:var(--text); font-family:var(--mono); font-size:0.88rem; outline:none; }
  .scan-input:focus { border-color:var(--cyan); }
  .scan-input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted2); font-size:16px; pointer-events:none; }
  .scan-btn { padding:13px 28px; background:linear-gradient(135deg,rgba(0,180,255,0.22),rgba(0,90,180,0.32)); border:1px solid rgba(0,180,255,0.45); border-radius:6px; color:var(--cyan); cursor:pointer; font-family:var(--orb); font-size:0.78rem; letter-spacing:2px; font-weight:700; white-space:nowrap; }
  .scan-btn:disabled { opacity:0.5; cursor:not-allowed; }
  .api-tags { display:flex; gap:6px; flex-wrap:wrap; margin-top:12px; }
  .api-tag { background:rgba(0,180,255,0.08); border:1px solid rgba(0,180,255,0.18); color:var(--muted2); padding:3px 10px; border-radius:12px; font-family:var(--mono); font-size:0.63rem; letter-spacing:1px; }

  /* ── Progress ── */
  .progress-wrap { margin-bottom:16px; }
  .progress-bar-bg { background:rgba(0,0,0,0.4); border-radius:4px; height:5px; overflow:hidden; margin:10px 0 8px; }
  .progress-bar-fill { height:100%; background:linear-gradient(90deg,#00B4FF,#0060CC); border-radius:4px; transition:width 0.8s ease; box-shadow:0 0 8px rgba(0,180,255,0.5); }
  .progress-label { display:flex; justify-content:space-between; align-items:center; }
  .progress-step { color:var(--text); font-family:var(--mono); font-size:0.78rem; }
  .progress-pct  { color:var(--cyan); font-family:var(--orb); font-size:0.85rem; font-weight:700; }

  /* ── Score Gauge ── */
  .results-summary { display:flex; align-items:center; gap:24px; flex-wrap:wrap; padding:20px 24px; border-radius:8px; margin-bottom:16px; }
  .gauge-wrap { text-align:center; min-width:110px; }
  .gauge-score { font-family:var(--orb); font-size:1.9rem; font-weight:900; line-height:1; }
  .gauge-label { font-family:var(--mono); font-size:0.55rem; letter-spacing:2px; color:var(--muted2); margin-top:4px; }
  .gauge-sev   { font-family:var(--orb); font-size:0.7rem; letter-spacing:2px; font-weight:700; margin-top:6px; }
  .summary-right { flex:1; min-width:200px; }
  .summary-title { font-family:var(--orb); font-size:1rem; font-weight:700; letter-spacing:2px; margin-bottom:6px; }
  .summary-sub   { color:#8AAFC0; font-family:var(--raj); font-size:0.95rem; margin-bottom:12px; }
  .stat-badges { display:flex; gap:8px; flex-wrap:wrap; }
  .stat-badge { flex:1; min-width:60px; background:rgba(10,20,35,0.8); border-radius:6px; padding:10px 10px; text-align:center; }
  .stat-badge .val { font-family:var(--orb); font-size:1.2rem; font-weight:900; }
  .stat-badge .lbl { font-family:var(--mono); font-size:0.58rem; letter-spacing:1px; color:var(--muted2); margin-top:2px; }
  .pdf-btn { display:inline-flex; align-items:center; gap:8px; padding:10px 20px; background:rgba(0,180,255,0.1); border:1px solid rgba(0,180,255,0.4); border-radius:6px; color:var(--cyan); cursor:pointer; font-family:var(--orb); font-size:0.68rem; letter-spacing:2px; align-self:flex-start; }

  /* ── Module Expander ── */
  .modules-list { display:flex; flex-direction:column; gap:6px; margin-top:8px; }
  .module-row { border-radius:6px; overflow:hidden; }
  .module-header { width:100%; padding:13px 16px; display:flex; align-items:center; gap:12px; background:rgba(8,16,28,0.85); border:1px solid; border-radius:6px; cursor:pointer; text-align:left; transition:all 0.2s; }
  .module-header:hover { filter:brightness(1.1); }
  .module-chevron { font-size:14px; flex-shrink:0; }
  .module-name { font-family:var(--orb); font-size:0.72rem; color:var(--text); letter-spacing:1px; font-weight:700; flex:1; }
  .module-bar-wrap { display:flex; align-items:center; gap:10px; }
  .module-bar { width:90px; height:5px; background:rgba(255,255,255,0.07); border-radius:3px; overflow:hidden; flex-shrink:0; }
  .module-bar-fill { height:100%; border-radius:3px; }
  .module-score { font-family:var(--orb); font-size:0.9rem; font-weight:900; min-width:30px; text-align:right; }
  .module-sev { padding:2px 9px; border-radius:4px; font-family:var(--mono); font-size:0.63rem; letter-spacing:1px; border:1px solid; min-width:58px; text-align:center; flex-shrink:0; }

  .module-body { border:1px solid; border-top:none; border-radius:0 0 6px 6px; padding:16px; display:none; }
  .module-body.open { display:block; }
  .module-summary { font-family:var(--raj); font-size:0.95rem; color:#8AAFC0; line-height:1.6; padding-left:12px; border-left-width:2px; border-left-style:solid; margin-bottom:18px; }
  .module-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; }
  .module-section { background:rgba(0,0,0,0.3); border-radius:6px; padding:14px; }
  .module-section-title { display:flex; align-items:center; gap:6px; margin-bottom:10px; font-family:var(--mono); font-size:0.68rem; letter-spacing:2px; }
  .module-section-item { display:flex; gap:8px; margin-bottom:6px; color:var(--text); font-family:var(--raj); font-size:0.9rem; line-height:1.45; }
  .module-section-num { font-family:var(--mono); font-size:0.68rem; flex-shrink:0; margin-top:2px; }
  .module-threat { background:rgba(255,140,0,0.05); border:1px solid rgba(255,140,0,0.2); border-radius:6px; padding:14px; }
  .module-threat-title { display:flex; align-items:center; gap:6px; margin-bottom:8px; font-family:var(--mono); font-size:0.68rem; letter-spacing:2px; color:#FF8C00; }
  .module-threat p { color:#E0C080; font-family:var(--raj); font-size:0.9rem; line-height:1.6; }
  .module-refs { margin-top:12px; display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
  .module-refs span { color:var(--muted2); font-family:var(--mono); font-size:0.68rem; }
  .module-refs a { display:inline-flex; align-items:center; gap:4px; color:#6080FF; text-decoration:none; font-size:0.8rem; font-family:var(--raj); padding:3px 10px; background:rgba(100,128,255,0.08); border:1px solid rgba(100,128,255,0.2); border-radius:4px; }
  .module-refs a:hover { background:rgba(100,128,255,0.15); }

  /* ── Info banner ── */
  .info-banner { display:flex; align-items:center; gap:8px; background:rgba(0,180,255,0.04); border:1px solid rgba(0,180,255,0.12); border-radius:6px; padding:9px 14px; margin-bottom:14px; color:var(--muted2); font-family:var(--mono); font-size:0.7rem; letter-spacing:1px; }

  /* ── Empty state ── */
  .empty-state { text-align:center; padding:70px 0; color:#1A2A35; }
  .empty-state p { font-family:var(--mono); font-size:0.85rem; color:#2A3A45; margin-top:12px; letter-spacing:1px; }

  /* ── History ── */
  .history-row { background:var(--card); border-radius:10px; overflow:hidden; margin-bottom:10px; }
  .history-row-header { padding:14px 20px; display:flex; align-items:center; gap:14px; cursor:pointer; }
  .history-icon { border-radius:8px; padding:8px; }
  .history-url { font-family:var(--mono); font-size:0.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1; }
  .history-meta { font-size:0.78rem; color:var(--muted2); margin-top:2px; }
  .history-score { font-family:var(--orb); font-size:1.3rem; font-weight:900; text-align:center; line-height:1; min-width:42px; }
  .history-sev   { font-family:var(--mono); font-size:0.6rem; letter-spacing:1px; text-align:center; margin-top:2px; }
  .history-actions { display:flex; align-items:center; gap:8px; }
  .history-pdf-btn { background:rgba(0,180,255,0.1); border:1px solid rgba(0,180,255,0.3); border-radius:6px; color:var(--cyan); cursor:pointer; padding:5px 12px; display:flex; align-items:center; gap:5px; font-size:0.75rem; font-family:var(--raj); }
  .history-del-btn { background:rgba(255,0,60,0.08); border:1px solid rgba(255,0,60,0.2); border-radius:6px; color:#FF6080; cursor:pointer; padding:6px; }
  .history-modules { padding:0 20px 18px; border-top:1px solid rgba(0,180,255,0.1); }
  .history-modules .modules-list { margin-top:14px; }

  /* ── Blogs ── */
  .blogs-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:18px; }
  .news-card { background:rgba(10,20,35,0.85); border:1px solid rgba(0,180,255,0.13); border-radius:10px; overflow:hidden; transition:all 0.25s; display:flex; flex-direction:column; text-decoration:none; color:inherit; }
  .news-card:hover { border-color:rgba(0,180,255,0.4); box-shadow:0 0 25px rgba(0,180,255,0.12); transform:translateY(-3px); }
  .news-thumb { height:155px; overflow:hidden; position:relative; }
  .news-thumb img { width:100%; height:100%; object-fit:cover; filter:brightness(0.65) saturate(0.5); }
  .news-thumb-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(10,20,35,0.8) 0%,transparent 60%); }
  .news-cat { position:absolute; top:10px; left:10px; padding:3px 8px; border-radius:4px; font-family:var(--mono); font-size:0.63rem; letter-spacing:1px; border:1px solid; }
  .news-body { padding:14px; flex:1; display:flex; flex-direction:column; }
  .news-title { color:var(--text); font-family:var(--raj); font-size:1.02rem; font-weight:700; line-height:1.4; margin-bottom:8px; flex:1; }
  .news-summary { color:var(--muted); font-family:var(--raj); font-size:0.85rem; line-height:1.5; margin-bottom:12px; display:-webkit-box; -webkit-line-clamp:3; line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .news-footer { display:flex; justify-content:space-between; align-items:center; border-top:1px solid rgba(0,180,255,0.08); padding-top:10px; font-family:var(--mono); font-size:0.68rem; }
  .news-date { color:var(--muted2); }
  .news-source { color:var(--cyan); display:flex; align-items:center; gap:4px; }

  /* ── PDF report ── */
  .pdf-section-title { font-size:12pt; font-weight:bold; text-decoration:underline; margin-top:16px; }
  .pdf-finding { margin-left:16px; margin-top:4px; }

  /* ── Ticker ── */
  .ticker { background:rgba(255,60,0,0.06); border:1px solid rgba(255,60,0,0.18); border-radius:6px; padding:8px 14px; margin-bottom:22px; display:flex; align-items:center; gap:10px; }
  .ticker span { color:#CC5040; font-family:var(--mono); font-size:0.72rem; letter-spacing:1px; }

  /* ── Scrollbar ── */
  ::-webkit-scrollbar { width:6px; }
  ::-webkit-scrollbar-track { background:#0A0F18; }
  ::-webkit-scrollbar-thumb { background:#1A3A4A; border-radius:3px; }

  /* ── Spinner ── */
  .spinner { width:28px; height:28px; border:3px solid rgba(0,180,255,0.15); border-top-color:var(--cyan); border-radius:50%; animation:spin 1s linear infinite; margin:0 auto; }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* ── Pages ── */
  .page { display:none; }
  .page.active { display:block; }

  @media(max-width:600px) {
    main { padding:16px; }
    nav { padding:0 14px; }
    nav .navlinks button { padding:7px 12px; font-size:0.6rem; }
    .results-summary { flex-direction:column; }
  }
</style>
</head>
<body>

<!-- ═══════════ AUTH GATE ═══════════ -->
<div id="auth-gate">
  <div style="text-align:center;margin-bottom:36px;position:relative;z-index:1">
    <div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:8px">
      <span style="font-size:2rem">🛡</span>
      <span style="font-family:var(--orb);font-size:2.2rem;font-weight:900;color:var(--cyan);text-shadow:0 0 20px rgba(0,180,255,0.8);letter-spacing:4px">SECLITE</span>
    </div>
    <p style="color:var(--muted);font-family:var(--mono);font-size:0.82rem;letter-spacing:3px">UNIFIED SECURITY SCANNER</p>
  </div>

  <div class="auth-box" id="auth-selector">
    <h2>ACCESS PORTAL</h2>
    <div class="auth-btn-group">
      <button class="auth-btn-user" onclick="showAuthForm('user')">👤 &nbsp;USER LOGIN</button>
      <div class="auth-divider">── OR ──</div>
      <button class="auth-btn-admin" onclick="showAuthForm('admin')">⚡ ADMIN ACCESS</button>
    </div>
  </div>

  <div class="auth-box" id="auth-user-form" style="display:none">
    <div class="auth-form-title" style="color:var(--cyan)">
      <button class="auth-back" onclick="showAuthSelector()">←</button> USER LOGIN
    </div>
    <label class="auth-label">EMAIL ADDRESS</label>
    <input id="login-email" class="auth-input" type="email" placeholder="you@example.com" />
    <div id="login-error" class="auth-error" style="display:none"></div>
    <button class="auth-submit auth-submit-user" onclick="doUserLogin()">ENTER SYSTEM</button>
  </div>

  <div class="auth-box" id="auth-admin-form" style="display:none">
    <div class="auth-form-title" style="color:#FF6080">
      <button class="auth-back" onclick="showAuthSelector()">←</button> ADMIN ACCESS
    </div>
    <label class="auth-label">USERNAME</label>
    <input id="admin-user" class="auth-input auth-input-red" type="text" placeholder="admin" />
    <label class="auth-label">PASSWORD</label>
    <input id="admin-pass" class="auth-input auth-input-red" type="password" placeholder="••••••••" />
    <div id="admin-error" class="auth-error" style="display:none"></div>
    <button class="auth-submit auth-submit-admin" onclick="doAdminLogin()">🔒 AUTHENTICATE</button>
  </div>
</div>

<!-- ═══════════ APP SHELL ═══════════ -->
<div id="app" style="display:none">
  <nav>
    <div class="logo" onclick="showPage('scan')">
      <span>🛡</span>
      <span>SECLITE</span>
    </div>
    <div class="navlinks">
      <button id="nav-scan"    class="active" onclick="showPage('scan')">SCAN</button>
      <button id="nav-history" onclick="showPage('history')">HISTORY</button>
      <button id="nav-blogs"   onclick="showPage('blogs')">DAILY BLOGS</button>
    </div>
    <div class="user-zone">
      <span id="admin-badge" class="admin-badge" style="display:none">ADMIN</span>
      <span class="username" id="nav-username"></span>
      <button class="logout-btn" onclick="doLogout()">↩ LOGOUT</button>
    </div>
  </nav>

  <!-- ── SCAN PAGE ── -->
  <main>
    <div id="page-scan" class="page active">
      <div style="margin-bottom:24px">
        <h1 style="font-family:var(--orb);font-size:1.35rem;color:var(--cyan);text-shadow:0 0 15px rgba(0,180,255,0.5);letter-spacing:3px;margin-bottom:6px">SECURITY SCANNER</h1>
        <p style="color:var(--muted2);font-family:var(--mono);font-size:0.73rem;letter-spacing:1px">Real-time multi-vector assessment · Google DNS · SSL Labs · URLScan.io · RDAP · Header Proxy</p>
